{
  "name": "bloom",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node frontend/scripts/copy-mediapipe.mjs",
    "dev": "tsx server.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json && vite build frontend",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p frontend/tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
