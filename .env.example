TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SHARED_SECRET=

# Frontend overrides (optional)
VITE_API_BASE=
VITE_HAND_MODEL_URL=
VITE_MEDIAPIPE_WASM=