# Copy this file to backend/.env and fill in what you need.
# Never commit your real .env file.

# development | production
BLOOM_ENV=development

# Signs login sessions. REQUIRED in production (at least 32 random characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development, leave it empty and a key is generated in data/dev-secret.key.
BLOOM_SECRET_KEY=

# Database. Empty = SQLite file at backend/data/bloom.db (good for local development).
# Production example: postgresql://bloom:CHANGE_ME@localhost:5432/bloom
DATABASE_URL=

# Where uploaded images are stored: "local" (files on disk) or "database"
# (inside the database; use this on hosts whose disk is wiped on restart,
# such as Render's free plan).
BLOOM_STORAGE=local
# Folder for "local" storage (default: backend/data/media)
BLOOM_MEDIA_DIR=

# Browser origins allowed to call the API (the Vite dev server by default)
BLOOM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Send cookies only over HTTPS (turn on in production)
BLOOM_COOKIE_SECURE=false

BLOOM_SESSION_DAYS=30
BLOOM_MAX_UPLOAD_MB=20

# Run database migrations automatically when the server starts
BLOOM_AUTO_MIGRATE=true

# --- Live Bloom (WebRTC) ---
# STUN helps browsers find a direct route to each other.
STUN_URLS=stun:stun.l.google.com:19302
# TURN relays video when a direct route is impossible (strict networks, many
# mobile carriers). You need your own TURN server or a hosted TURN service.
# Example: TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
# Either static credentials...
TURN_USERNAME=
TURN_CREDENTIAL=
# ...or coturn's shared secret (static-auth-secret) for short-lived credentials.
TURN_SHARED_SECRET=
