# Optional frontend settings. Copy to frontend/.env.local if you need them.

# Only needed if the API is on a different address than the website
# (the Vite dev server already forwards /api to http://127.0.0.1:8000).
VITE_API_BASE=

# Where MediaPipe's hand-tracking files come from (defaults shown).
VITE_MEDIAPIPE_WASM=/mediapipe/wasm
VITE_HAND_MODEL_URL=
